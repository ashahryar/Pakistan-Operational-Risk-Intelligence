# Copy to .env (never commit .env). Docker Compose reads it for variable substitution; the Airflow containers also mount it at /opt/project/.env.
# Everything below is a placeholder: generate your own values.

# --- Airflow web server session key (required). Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=change-me

# --- PostgreSQL / Airflow admin. Set BEFORE the first `docker compose up` of a deployment (the database is initialised once, on first start).
# Defaults for local development are "airflow" / "admin"; do not use them on a shared or public host.
POSTGRES_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
# The services read the application database credentials from an optional, untracked file `.env.deploy` (create it next to .env):
#     DB_PASSWORD=<the same value as POSTGRES_PASSWORD>

# --- Optional S3 archiving of raw / parsed files (off by default, see PORI_S3_UPLOAD in .env.docker). Leave blank to run without AWS.
# To enable: put valid values here and set PORI_S3_UPLOAD=auto in .env.docker.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# --- Optional: a language model for RAG / intelligence / agent answers. Without it those endpoints return evidence only and say the model is unavailable.
PORI_LLM_PROVIDER=
PORI_LLM_MODEL=
PORI_LLM_API_KEY=
PORI_LLM_BASE_URL=

# --- Ports (defaults shown)
# API_PORT=8000
# DASHBOARD_PORT=8501
