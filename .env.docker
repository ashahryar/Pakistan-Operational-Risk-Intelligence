DB_HOST=postgres
DB_PORT=5432
DB_NAME=airflow
DB_USER=airflow
DB_PASSWORD=airflow
# Task 40: S3 archiving is OFF by default. The AWS keys in a developer .env may be rotated or revoked (they were rejected as InvalidAccessKeyId); set to auto to enable archiving once valid keys are in .env.
PORI_S3_UPLOAD=off
